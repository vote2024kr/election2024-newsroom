digraph ERD {graph [rankdir=LR bgcolor="white" fontname="Noto Sans CJK KR" nodesep=.22 ranksep=.55]; node [shape=record style="rounded,filled" fillcolor="#f3f7fc" color="#4d719d" fontname="Noto Sans CJK KR" fontsize=10]; edge[color="#6b7b96" fontsize=10];source[label="{SOURCE (향후 DB)|source_id PK\ltype\lurl\lsha256\lverified=false\l}"];election[label="{ELECTION (설계)|election_id PK\lname\lmode\l}"];region[label="{REGION (설계)|region_id PK\lelection_id FK\lname\l}"];district[label="{DISTRICT (설계)|district_id PK\lregion_id FK\lname\l}"];candidate[label="{CANDIDATE (설계)|candidate_id PK\ldistrict_id FK\lname\l}"];snap[label="{VOTE_SNAPSHOT (설계)|snapshot_id PK\ldistrict_id FK\lstep\lupdated_at\lmode\l}"];votes[label="{VOTE_COUNT (설계)|snapshot_id FK\lcandidate_id FK\lvotes\l}"];doc[label="{RAG_DOCUMENT (설계)|doc_id PK\lsource_id FK\lpublisher\ldate\l}"];article[label="{ARTICLE_DRAFT (설계)|article_id PK\lsnapshot_id FK\ltext\lstatus\l}"];check[label="{VALIDATION (설계)|validation_id PK\larticle_id FK\lpassed\lerrors\l}"];review[label="{REVIEW (설계)|review_id PK\larticle_id FK\leditor\lreason\ltime\l}"];audit[label="{PROJECT1_EVENT (SQLite 구현)|event_id PK\larticle_id\lscenario\lstatus\ldetail\l}"];source->election;source->doc;election->region->district;district->candidate;district->snap;snap->votes;candidate->votes;snap->article;doc->article;article->check;article->review;review->audit;check->audit;}